# Samakan dengan project Supabase yang dipakai situs.
# Keduanya memang publik; jangan pernah menaruh service_role atau secret key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# URL situs GoDiand untuk tautan Syarat Layanan dan Kebijakan Privasi.
# Ganti dengan domain produksi saat situs sudah online.
EXPO_PUBLIC_SITE_URL=https://godiand.example
